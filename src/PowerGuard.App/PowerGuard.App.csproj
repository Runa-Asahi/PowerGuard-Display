<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- 仅用于 System.Windows.Forms.NotifyIcon 托盘图标 -->
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <AssemblyName>PowerGuardDisplay</AssemblyName>
    <RootNamespace>PowerGuard.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Product>PowerGuard Display（断电护屏）</Product>
    <Version>1.2.0</Version>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <!-- WPF 通过 manifest 声明 PerMonitorV2；WinForms 仅用于托盘 -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
  </PropertyGroup>

  <ItemGroup>
    <!-- WPF 与 WinForms 同时启用时避免命名冲突 -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
    <Using Include="System.IO" />
  </ItemGroup>

  <ItemGroup>
    <!-- 托盘状态图标（由 tools/gen-icons.py 生成）。资源名：PowerGuard.App.Assets.tray-*.ico -->
    <EmbeddedResource Include="Assets\tray-*.ico" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PowerGuard.Core\PowerGuard.Core.csproj" />
  </ItemGroup>

</Project>
