<Window x:Class="PowerGuard.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PowerGuard Display · 断电护屏" Width="1080" Height="740" MinWidth="760" MinHeight="520"
        Background="{StaticResource WindowBg}" FontFamily="{StaticResource UiFont}"
        WindowStartupLocation="CenterScreen" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 导航 -->
        <DockPanel Grid.Column="0" Margin="12,16,4,12">
            <StackPanel DockPanel.Dock="Top" Margin="10,0,0,20">
                <TextBlock Text="断电护屏" FontSize="18" FontWeight="SemiBold"/>
                <TextBlock Text="PowerGuard Display" Style="{StaticResource Label}"/>
            </StackPanel>
            <TextBlock DockPanel.Dock="Bottom" x:Name="VersionText" Style="{StaticResource Label}" Margin="10,0"/>
            <ListBox x:Name="Nav" BorderThickness="0" Background="Transparent" SelectionChanged="Nav_SelectionChanged"
                     ItemContainerStyle="{StaticResource NavItem}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBoxItem Content="🛡  控制台" IsSelected="True"/>
                <ListBoxItem Content="⚙  设置"/>
                <ListBoxItem Content="📄  运行日志"/>
            </ListBox>
        </DockPanel>

        <Border Grid.Column="1" Background="#F9F9F9" BorderBrush="{StaticResource CardBorder}" BorderThickness="1,0,0,0" CornerRadius="8,0,0,0">
            <Grid Margin="24,20,12,12">

                <!-- ───────── 控制台 ───────── -->
                <ScrollViewer x:Name="DashboardPage" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="控制台" Style="{StaticResource Title}"/>

                        <!-- 总状态横幅 -->
                        <Border Style="{StaticResource Card}" x:Name="Banner">
                            <DockPanel>
                                <Ellipse x:Name="BannerDot" Width="14" Height="14" Margin="0,4,14,0" VerticalAlignment="Top" Fill="{StaticResource Ok}"/>
                                <StackPanel>
                                    <TextBlock x:Name="BannerTitle" FontSize="18" FontWeight="SemiBold" Text="正在初始化…"/>
                                    <TextBlock x:Name="BannerDetail" Style="{StaticResource Hint}"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <UniformGrid x:Name="StatusGrid" Columns="5">
                            <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="保护功能" Style="{StaticResource Label}"/><TextBlock x:Name="ProtectionText" Style="{StaticResource Value}"/></StackPanel></Border>
                            <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="电源状态" Style="{StaticResource Label}"/><TextBlock x:Name="PowerText" Style="{StaticResource Value}"/></StackPanel></Border>
                            <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="当前显示模式" Style="{StaticResource Label}"/><TextBlock x:Name="ModeText" Style="{StaticResource Value}"/></StackPanel></Border>
                            <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="自动恢复" Style="{StaticResource Label}"/><TextBlock x:Name="AutoRestoreText" Style="{StaticResource Value}"/></StackPanel></Border>
                            <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="笔记本内屏" Style="{StaticResource Label}"/><TextBlock x:Name="InternalText" Style="{StaticResource Value}"/></StackPanel></Border>
                            <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="外接活动显示路径（Windows 检测）" Style="{StaticResource Label}"/><TextBlock x:Name="ExternalText" Style="{StaticResource Value}"/></StackPanel></Border>
                            <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="外接可用目标（Windows 检测）" Style="{StaticResource Label}"/><TextBlock x:Name="ExternalAvailText" Style="{StaticResource Value}"/></StackPanel></Border>
                            <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="恢复流程" Style="{StaticResource Label}"/><TextBlock x:Name="FlowText" Style="{StaticResource Value}"/></StackPanel></Border>
                            <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="登录自启动" Style="{StaticResource Label}"/><TextBlock x:Name="StartupText" Style="{StaticResource Value}"/></StackPanel></Border>
                            <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="触发方式" Style="{StaticResource Label}"/><TextBlock x:Name="TriggerModeText" Style="{StaticResource Value}"/></StackPanel></Border>
                            <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="最近触发原因" Style="{StaticResource Label}"/><TextBlock x:Name="TriggerReasonText" Style="{StaticResource Value}"/></StackPanel></Border>
                            <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="外接路径消失确认" Style="{StaticResource Label}"/><TextBlock x:Name="LostConfirmText" Style="{StaticResource Value}"/></StackPanel></Border>
                            <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="未完成的恢复标记" Style="{StaticResource Label}"/><TextBlock x:Name="MarkerExistsText" Style="{StaticResource Value}"/></StackPanel></Border>
                            <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="关机前尝试" Style="{StaticResource Label}"/><TextBlock x:Name="ShutdownTryText" Style="{StaticResource Value}"/></StackPanel></Border>
                        </UniformGrid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3*"/>
                                <ColumnDefinition Width="2*"/>
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="快捷操作" Style="{StaticResource CardTitle}"/>
                                    <WrapPanel>
                                        <Button x:Name="BtnInternal" Style="{StaticResource Primary}" Content="立即切回笔记本内屏" Click="BtnInternal_Click"/>
                                        <Button x:Name="BtnRestore" Content="尝试恢复首选显示模式" Click="BtnRestore_Click"/>
                                        <Button x:Name="BtnPause" Content="暂停自动保护" Click="BtnPause_Click"/>
                                        <Button x:Name="BtnDiscard" Content="放弃未完成的恢复" Click="BtnDiscard_Click" Visibility="Collapsed"/>
                                        <Button Content="打开设置" Click="GoSettings_Click"/>
                                        <Button Content="查看日志" Click="GoLogs_Click"/>
                                        <Button Content="打开日志目录" Click="OpenLogDir_Click"/>
                                    </WrapPanel>
                                    <Border x:Name="ResultBox" Visibility="Collapsed" Margin="0,8,0,0" Padding="12,10" CornerRadius="6" Background="#FFF4F4">
                                        <StackPanel>
                                            <TextBlock x:Name="ResultText" FontWeight="SemiBold"/>
                                            <TextBlock x:Name="ResultNext" Style="{StaticResource Hint}"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="最近事件" Style="{StaticResource CardTitle}"/>
                                    <TextBlock x:Name="LastEventTime" Style="{StaticResource Label}"/>
                                    <TextBlock x:Name="LastEventText" Margin="0,4,0,0"/>
                                    <TextBlock x:Name="MarkerText" Style="{StaticResource Hint}" Margin="0,10,0,0"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <TextBlock Style="{StaticResource Hint}" Margin="2,0,12,8"
                                   Text="说明：“外接活动显示路径”= Windows 当前正在向该外接目标输出的路径；“外接可用目标”= Windows 检测到外接显示路径可连接（targetAvailable）。两者都来自 QueryDisplayConfig，都不代表显示器已经通电亮屏。部分 HDMI 显示器关机/断电后仍保留 EDID/热插拔信号，Windows 可能继续保持活动路径，此时无法检测到显示器断电；恢复是否真正出画面请以肉眼为准。"/>
                    </StackPanel>
                </ScrollViewer>

                <!-- ───────── 设置 ───────── -->
                <ScrollViewer x:Name="SettingsPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel MaxWidth="820" HorizontalAlignment="Left">
                        <TextBlock Text="设置" Style="{StaticResource Title}"/>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="保护与恢复" Style="{StaticResource CardTitle}"/>
                                <CheckBox x:Name="SAutoSwitch" Content="启用自动保护（按下方“触发方式”切回笔记本内屏）"/>
                                <CheckBox x:Name="SAutoRestore" Content="来电后在外接显示器稳定可用时自动恢复首选模式"/>
                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="首选显示模式" VerticalAlignment="Center"/>
                                    <ComboBox x:Name="SPreferred" Grid.Column="1" Width="240" HorizontalAlignment="Left">
                                        <ComboBoxItem Tag="Internal" Content="仅笔记本屏幕（internal）"/>
                                        <ComboBoxItem Tag="External" Content="仅外接显示器（external）"/>
                                        <ComboBoxItem Tag="Extend" Content="扩展（extend）"/>
                                        <ComboBoxItem Tag="Clone" Content="复制（clone）"/>
                                    </ComboBox>
                                </Grid>
                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="触发方式" VerticalAlignment="Center"/>
                                    <ComboBox x:Name="STriggerMode" Grid.Column="1" Width="320" HorizontalAlignment="Left">
                                        <ComboBoxItem Tag="Recommended" Content="推荐：市电转电池时先确认外接活动路径已消失"/>
                                        <ComboBoxItem Tag="Compatibility" Content="兼容：市电转电池即切回内屏（第一版行为）"/>
                                    </ComboBox>
                                </Grid>
                                <TextBlock Style="{StaticResource Hint}" Text="推荐：只拔笔记本电源而显示器仍在显示时不会切屏（只记录）；市电转电池且外接活动路径已消失才切回内屏。代价：若显示器断电后 Windows 仍保持活动路径（见下），推荐模式在断电时不会切屏。"/>
                                <TextBlock Style="{StaticResource Hint}" Text="兼容：只要确认市电转电池就切回内屏，不看外接路径。代价：只拔电源、显示器仍亮时也会切走外接屏，来电后再恢复。"/>
                                <TextBlock Style="{StaticResource Hint}" Text="两种模式都会检测“外接活动显示路径消失”：上一次为“仅第二屏幕”且有外接活动路径，变为 0 条并在确认时间后重新查询仍为 0，即切回内屏；市电一直正常时，外接目标重新可用并稳定后即可恢复。按 Win+P 主动切换（外接目标仍可用）以及本程序/手动切屏后 15 秒内不会触发。"/>
                                <TextBlock Style="{StaticResource Hint}" Text="HDMI 限制：部分显示器关机或断电后仍向电脑保留 EDID/热插拔信号，Windows 会继续报告外接路径，此时无法检测到显示器断电。“Windows 检测到外接显示路径”不等于显示器已亮屏。"/>
                                <TextBlock Style="{StaticResource Hint}" Text="更改首选模式只会保存配置，不会立即切换显示；已在进行中的恢复流程使用断电时保存的首选模式快照。"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="时间与重试" Style="{StaticResource CardTitle}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                                    <TextBlock Text="显示器稳定等待时间" VerticalAlignment="Center"/>
                                    <TextBox x:Name="SStability" Grid.Column="1" Margin="0,4"/>
                                    <TextBlock Grid.Column="2" Text="秒（3–600）" Style="{StaticResource Hint}" Margin="8,0" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Row="1" Text="恢复超时时间" VerticalAlignment="Center"/>
                                    <TextBox x:Name="STimeout" Grid.Row="1" Grid.Column="1" Margin="0,4"/>
                                    <TextBlock Grid.Row="1" Grid.Column="2" Text="分钟（1–1440，从市电恢复起计）" Style="{StaticResource Hint}" Margin="8,0" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Row="2" Text="失败重试间隔" VerticalAlignment="Center"/>
                                    <TextBox x:Name="SRetryInterval" Grid.Row="2" Grid.Column="1" Margin="0,4"/>
                                    <TextBlock Grid.Row="2" Grid.Column="2" Text="秒（5–3600）" Style="{StaticResource Hint}" Margin="8,0" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Row="3" Text="最大重试次数" VerticalAlignment="Center"/>
                                    <TextBox x:Name="SMaxRetries" Grid.Row="3" Grid.Column="1" Margin="0,4"/>
                                    <TextBlock Grid.Row="3" Grid.Column="2" Text="次（0–10，不含首次尝试）" Style="{StaticResource Hint}" Margin="8,0" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Row="4" Text="外接路径消失确认时间" VerticalAlignment="Center"/>
                                    <TextBox x:Name="SLostConfirm" Grid.Row="4" Grid.Column="1" Margin="0,4"/>
                                    <TextBlock Grid.Row="4" Grid.Column="2" Text="秒（2–120，仅推荐模式）" Style="{StaticResource Hint}" Margin="8,0" VerticalAlignment="Center"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="启动、通知与日志" Style="{StaticResource CardTitle}"/>
                                <CheckBox x:Name="SStartup" Content="当前用户登录后自动启动（Windows 任务计划程序，无需管理员）"/>
                                <CheckBox x:Name="SShutdownTry" Content="正常关机/注销时尽力尝试一次切到首选模式（实验性，默认关闭）"/>
                                <TextBlock Style="{StaticResource Hint}" Margin="22,0,0,6" Text="仅在存在未完成的恢复流程、电源条件满足且 Windows 报告外接路径可用时尝试，限时约 3 秒，不会阻止关机，也不会清除恢复标记；下次开机后会重新校验，确认已是首选模式才清除。无法保证 BIOS、开机画面或登录界面会显示在 HDMI 显示器上；突然断电导致的关机不会触发这一尝试。"/>
                                <CheckBox x:Name="SNotify" Content="显示系统通知"/>
                                <CheckBox x:Name="SRetainLogs" Content="自动保留运行日志（保留 14 天；关闭后每次启动只保留当天日志）"/>
                            </StackPanel>
                        </Border>
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource Primary}" Content="保存设置" Click="SaveSettings_Click"/>
                            <Button Content="撤销更改" Click="RevertSettings_Click"/>
                        </StackPanel>
                        <TextBlock x:Name="SettingsResult" Style="{StaticResource Hint}" Margin="2,0,12,12"/>
                    </StackPanel>
                </ScrollViewer>

                <!-- ───────── 日志 ───────── -->
                <DockPanel x:Name="LogsPage" Visibility="Collapsed">
                    <TextBlock DockPanel.Dock="Top" Text="运行日志" Style="{StaticResource Title}"/>
                    <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                        <ComboBox x:Name="LogCategoryFilter" Width="130" Margin="0,0,8,8" SelectionChanged="LogFilter_Changed"/>
                        <ComboBox x:Name="LogResultFilter" Width="110" Margin="0,0,8,8" SelectionChanged="LogFilter_Changed"/>
                        <TextBox x:Name="LogSearch" Width="200" Margin="0,0,8,8" TextChanged="LogFilter_Changed" ToolTip="按内容筛选"/>
                        <Button Content="复制所选" Click="CopySelectedLogs_Click"/>
                        <Button Content="复制全部（筛选后）" Click="CopyAllLogs_Click"/>
                        <Button Content="打开日志目录" Click="OpenLogDir_Click"/>
                        <Button Content="清空日志…" Click="ClearLogs_Click"/>
                    </WrapPanel>
                    <Border Background="White" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="8" Margin="0,0,12,0">
                        <DataGrid x:Name="LogGrid" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#EEEEEE" BorderThickness="0" Background="White"
                                  RowHeaderWidth="0" SelectionMode="Extended" CanUserResizeRows="False" FontSize="12.5"
                                  EnableRowVirtualization="True" VirtualizingPanel.IsVirtualizing="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="时间" Binding="{Binding Time, StringFormat=yyyy-MM-dd HH:mm:ss}" Width="150"/>
                                <DataGridTextColumn Header="类型" Binding="{Binding CategoryText}" Width="80"/>
                                <DataGridTextColumn Header="结果" Binding="{Binding ResultText}" Width="60"/>
                                <DataGridTextColumn Header="详细说明" Binding="{Binding Message}" Width="*">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </DockPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
